# AEGIS — Anti-Cheat Exam Portal


#  Database
DATABASE_URL=postgresql+asyncpg://aegis:aegis_dev_pw@localhost:5432/aegis
DATABASE_URL_SYNC=postgresql://aegis:aegis_dev_pw@localhost:5432/aegis

#  JWT
JWT_SECRET_KEY=change_me_to_a_random_64_char_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

#  Azure identity (managed identity / service principal client ID)
AZURE_CLIENT_ID=

#  Azure Service Bus
AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://...
AZURE_SERVICE_BUS_QUEUE_NAME=telemetry-events
SCORE_QUEUE_NAME=score-jobs

#  Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...
AZURE_STORAGE_CONTAINER_NAME=event-tape

#  Azure Communication Services (email)
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=
FRONTEND_BASE_URL=http://localhost:5173

#  AI features (1A integrity brief, 1B grading, 1C collusion)
#  Priority: Azure OpenAI -> Ollama -> dev stub
#  Set AI_FEATURES_ENABLED=false to disable entirely.
AI_FEATURES_ENABLED=true

#  Azure OpenAI (production) — gpt-4.1 + text-embedding-3-small
#  https://learn.microsoft.com/azure/ai-services/openai/concepts/models
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

#  Ollama (local twin — OpenAI-compatible /v1 API)
#  docker compose: OLLAMA_BASE_URL=http://ollama:11434/v1
#  local machine:  OLLAMA_BASE_URL=http://localhost:11434/v1
#  Models: qwen3:8b (chat), nomic-embed-text (embeddings)
OLLAMA_BASE_URL=
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

#  App
APP_ENV=development
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
LOG_LEVEL=DEBUG

#  Frontend (Vite public vars — prefix with VITE_)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
