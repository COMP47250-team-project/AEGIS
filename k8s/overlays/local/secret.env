# LOCAL DEV SECRET VALUES — throwaway, not real credentials.
# Mirrors docker-compose.yml. The Azurite key is the well-known public dev
# account key baked into the emulator (not a secret). Safe to commit for local
# convenience; real environments use overlays/aks with out-of-band secrets.
DATABASE_URL=postgresql+asyncpg://dev:dev@postgres:5432/appdb
JWT_SECRET_KEY=local_dev_only_not_a_real_secret_change_in_prod_0000000000
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
