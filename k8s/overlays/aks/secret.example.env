# TEMPLATE ONLY — copy to `secret.env` (gitignored) and fill with REAL values,
# or apply the secret out-of-band (kubectl create secret / Key Vault CSI).
# These point at MANAGED Azure services (no in-cluster Postgres/Azurite on AKS).
#
#   cp secret.example.env secret.env   # then edit secret.env
#
# DATABASE_URL uses the asyncpg driver (alembic/env.py reads DATABASE_URL) and
# requires TLS to Azure Postgres Flexible Server (ssl=require via asyncpg).
DATABASE_URL=postgresql+asyncpg://aegisadmin:CHANGEME@YOUR-PG.postgres.database.azure.com:5432/aegis?ssl=require
JWT_SECRET_KEY=CHANGEME_64_char_random_string
AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://YOUR-NS.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=CHANGEME
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOURACCT;AccountKey=CHANGEME;EndpointSuffix=core.windows.net
